# ── SiteShrimp Telegram Bridge — Configuration ──────────────────
# Copy this file to .env and fill in your values.
# All values are self-hosted — you control everything.

# ── Required ─────────────────────────────────────────────────────
TG_BOT_TOKEN=123456789:AAFxxxx...
PB_URL=https://your-pocketbase-server.com
PB_EMAIL=admin@yourcompany.com
PB_PASSWORD=your-password

# ── AI Provider (pick one) ───────────────────────────────────────
AI_PROVIDER=gemini

# Google Gemini (free, 1500/day)
GEMINI_KEY=AIzaSy...

# OpenAI / GPT (or compatible API)
# OPENAI_KEY=sk-...
# OPENAI_URL=https://api.openai.com
# OPENAI_MODEL=gpt-4o-mini

# Ollama (local, private)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llava

# ── Optional ─────────────────────────────────────────────────────
# PROJECT_ID=abc123          # Default project ID (auto-detects if not set)
# POLL_INTERVAL=1000         # Polling interval in ms (default: 1000)
